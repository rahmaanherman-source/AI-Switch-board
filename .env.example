# GitHub webhook signature verification (same secret configured in GitHub App settings)
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# GitHub App credentials required to post real PR comments
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"

# Sentry monitoring (optional locally; required for monitored deployments)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173

# AI API keys (only configure services you intend to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
